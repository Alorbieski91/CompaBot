TOKEN=your_discord_bot_token
# Optional: register commands immediately in your personal server.
GUILD_ID=
# Optional: Discord user IDs allowed to run /server commands, comma-separated.
SERVER_ADMIN_IDS=
# Optional: folder holding the Icarus PowerShell scripts (default C:\IcarusServer\scripts).
ICARUS_SCRIPTS_DIR=
# Optional: hours between automatic Icarus update checks (default 2; 0 turns them off).
AUTO_UPDATE_HOURS=
# Optional: Discord channel ID where Compabot posts about automatic updates.
AUTO_UPDATE_CHANNEL_ID=
# Optional: channel ID where Compabot posts when the Icarus server goes down, crashes, or comes back.
ALERT_CHANNEL_ID=
# Optional: start the Icarus server each morning, restarting it if it ran overnight with nobody on (24-hour time, default 06:00; off turns it off).
SERVER_START_TIME=
# Optional: shut the Icarus server down each evening if nobody is on (24-hour time, default 20:00; off turns it off).
SERVER_STOP_TIME=
# Optional: time zone for the two times above (default America/Chicago, US Central time).
SERVER_TIMEZONE=
