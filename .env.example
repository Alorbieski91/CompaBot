TOKEN=your_discord_bot_token
# Optional: register commands immediately in your personal server.
GUILD_ID=
# Optional: Discord user IDs allowed to run /server commands, comma-separated.
SERVER_ADMIN_IDS=
# Optional: folder holding the Icarus PowerShell scripts (default C:\IcarusServer\scripts).
ICARUS_SCRIPTS_DIR=
# Optional: folder holding the Valheim PowerShell scripts (default C:\ValheimServer\scripts).
VALHEIM_SCRIPTS_DIR=
# Optional: folder holding the Palworld PowerShell scripts (default C:\PalworldServer\scripts).
PALWORLD_SCRIPTS_DIR=
# Optional: hours between automatic game (Icarus, Valheim and Palworld) and Icarus mod update checks (default 2, decimals allowed; 0 turns them off).
AUTO_UPDATE_HOURS=
# Optional: Discord channel ID where Compabot posts about automatic updates.
AUTO_UPDATE_CHANNEL_ID=
# Optional: channel ID where Compabot posts when a game server (Icarus, Valheim or Palworld) goes down, crashes, or comes back.
ALERT_CHANNEL_ID=
# Optional: start each game server each morning, restarting it if it ran overnight with nobody on (24-hour time, default 06:00; off turns it off).
SERVER_START_TIME=
# Optional: shut each game server down each evening if nobody is on (24-hour time, default 20:00; off turns it off).
SERVER_STOP_TIME=
# Optional: time zone for the two times above (default America/Chicago, US Central time).
SERVER_TIMEZONE=
# Optional: whether each game follows the start and stop times and time zone above (on or off). Blank means Icarus on, Valheim and Palworld off.
ICARUS_ACTIVE_HOURS=
VALHEIM_ACTIVE_HOURS=off
PALWORLD_ACTIVE_HOURS=off
# Optional: Discord webhook URL where the watchdog (Watch-CompaBot.ps1) posts updates and restarts. It works while Compabot is down.
WATCHDOG_WEBHOOK_URL=
